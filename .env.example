# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/perfume_erp?schema=public"

# Authentication
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auraic storefront: copy the store ID shown in Dashboard > Storefront.
STOREFRONT_STORE_ID=""

# Optional image uploads (HTTPS image links work without these).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# New database owner bootstrap (trusted shell / manual GitHub workflow only).
OWNER_STORE_NAME="Auraic"
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_STORE_ID=""

# Optional server-side origin override for preview/test hosts.
# Defaults to NEXT_PUBLIC_APP_URL.
STOREFRONT_ORIGIN=""

# Server-only Firebase service-account JSON. Never add the private key to the repo/APK.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Bearer secret used by GET /api/cron/notifications to retry queued deliveries.
CRON_SECRET=""
